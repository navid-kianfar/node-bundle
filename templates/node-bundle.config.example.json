{
  "$comment": "node-bundle config. Put these fields in a `node-bundle` key inside package.json, in a node-bundle.config.json file, or pass an external file with --config. CLI flags override everything.",
  "name": "myapp",
  "node": "22",
  "targets": "linux-x64,linux-arm64",
  "mode": "auto",
  "obfuscate": "safe",
  "bytecode": true,
  "build": true,
  "buildCommand": "npm run build",
  "entry": "dist/main.js",
  "assets": ["views/**/*", "config/*.json"],
  "externals": ["bcrypt", "sharp"],
  "ext": "",
  "staticDirs": [
    { "from": "public", "to": "public", "embed": false }
  ],
  "buildPackages": [
    { "package": "@acme/frontend", "from": "dist", "to": "public", "embed": false }
  ]
}
